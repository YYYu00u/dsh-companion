{
  "name": "@dsh-companion/web",
  "version": "0.3.1",
  "type": "module",
  "description": "Local web chat UI for dsh-companion: same brain as the preset, plus her notebook, mood, diary, stickers, and daily life.",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "companion",
    "web-ui"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./delivery": "./delivery.js",
    "./life": "./life.js",
    "./exam": "./exam.js",
    "./senses": "./senses.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "life.js",
    "exam.js",
    "senses.js",
    "delivery.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "public/*"
  ],
  "dependencies": {
    "@dsh-companion/core": "file:../core"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YYYu00u/dsh-companion.git",
    "directory": "packages/web"
  },
  "homepage": "https://github.com/YYYu00u/dsh-companion#readme",
  "bugs": {
    "url": "https://github.com/YYYu00u/dsh-companion/issues"
  }
}
