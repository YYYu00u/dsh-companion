{
  "name": "@dsh-companion/voice",
  "version": "0.1.0",
  "type": "module",
  "description": "Local voice for a companion: zero-shot cloning (ZipVoice) over a small set of reference voices, exposed as click-to-play speech in the web room.",
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "companion",
    "tts",
    "voice",
    "zipvoice"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./voices": "./src/voices.js",
    "./engine": "./src/engine.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "src/*.js",
    "runtime/tts-server.py",
    "runtime/requirements.txt",
    "assets/voices.json",
    "scripts/*.mjs",
    "docs/**",
    "cordis.patch.yml",
    "page/*"
  ],
  "scripts": {
    "models": "node scripts/download-models.mjs",
    "refs": "node scripts/make-refs.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YYYu00u/dsh-companion.git",
    "directory": "packages/voice"
  }
}
